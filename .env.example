# pkdealer demo environment overrides.
# Copy to `.env` to apply; all defaults are baked into docker-compose.yml,
# so an empty `.env` (or no `.env` at all) works out of the box on Docker
# Desktop for macOS/Windows.

# ── Ollama (host-side) ───────────────────────────────────────────────
# The ollama agent container reaches the host via host.docker.internal.
# Override the URL if your ollama listens elsewhere.
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1

# ── Claude (not in compose by default) ───────────────────────────────
# Uncomment to enable an Anthropic-backed agent; you would also need to
# add a service entry for it in docker-compose.yml (see DEMO.md).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
